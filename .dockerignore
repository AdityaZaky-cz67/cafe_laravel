# ============================================================
#  .dockerignore — Brewly Coffee
#  File & folder yang TIDAK di-copy ke Docker image
# ============================================================

# Git
.git
.gitignore
.gitattributes

# Docker files (tidak perlu di dalam image)
docker-compose*.yml
.dockerignore

# PHP/Laravel
vendor/
node_modules/
.env
.env.*
!.env.example

# Storage (generated files)
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Development tools
.editorconfig
.phpunit.result.cache

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
public/hot
public/storage
