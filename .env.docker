APP_NAME="Brewly Coffee"
APP_ENV=local
APP_KEY=base64:ykR0k7hQ8tqjH7V4s9Z2qC1m8K0xP3yL5eA6fB7cD8E=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (MySQL di dalam Docker) ----
DB_CONNECTION=mysql
DB_HOST=db              # ← Nama service di docker-compose
DB_PORT=3306
DB_DATABASE=brewly_coffee
DB_USERNAME=brewly_user
DB_PASSWORD=brewly_password
DB_ROOT_PASSWORD=root_secret

# ---- Cache & Session ----
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# ---- Mail (opsional) ----
MAIL_MAILER=log

# ---- Broadcasting ----
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
